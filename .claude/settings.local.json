{
  "permissions": {
    "allow": [
      "Bash(chmod:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(npm install)",
      "Bash(npm run install-browsers:*)",
      "Bash(npx playwright install chromium)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "Bash(npm pack)",
      "Bash(cat:*)",
      "Bash(tar:*)",
      "Bash(sha256sum:*)",
      "Bash(node:*)",
      "Bash(nvm use:*)",
      "Bash(source ~/.nvm/nvm.sh)",
      "Bash(npm install:*)",
      "Bash(tree:*)",
      "Skill(drawnote)",
      "Bash(npm --version:*)",
      "mcp__thread-manager__list_threads",
      "mcp__thread-manager__update_thread",
      "SlashCommand(/thread switch 8f78af46-53dc-4847-b0b5-89d8a31184d4)",
      "mcp__thread-manager__create_thread",
      "mcp__thread-manager__switch_thread",
      "Bash(npm run build:*)",
      "mcp__thread-manager__get_current_thread",
      "Bash(pkill:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "thread-manager"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/record-user-message.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "spinnerTipsEnabled": false
}
